#!/usr/bin/env python3
"""Trusted host adapter for ThinkPixelAG harness-guidance/v1 (stdlib only)."""
import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import ssl
import stat
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid

CONTRACT = "thinkpixelag.harness-guidance/v1"
MAX_GUIDANCE = 65536
ROUTES = {
    "agents.list": ("GET", "/v1/agents"),
    "agents.describe": ("GET", "/v1/agents/{agent_id}"),
    "runs.admit": ("POST", "/v1/agents/{agent_id}/runs"),
    "runs.list": ("GET", "/v1/runs"),
    "runs.read": ("GET", "/v1/runs/{run_id}"),
    "runs.events": ("GET", "/v1/runs/{run_id}/events"),
    "runs.cancel": ("POST", "/v1/runs/{run_id}/cancel"),
    "runs.signal": ("POST", "/v1/runs/{run_id}/signals"),
}


class GuidanceError(Exception):
    """Messages are fixed safe categories, never remote bodies or credentials."""

    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


def private_read(path, limit):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as f:
            info = os.fstat(f.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise GuidanceError("host input must be an owned private regular file")
            raw = f.read(limit + 1)
        if len(raw) > limit:
            raise GuidanceError("host input exceeds bounds")
        return raw
    except OSError:
        raise GuidanceError("protected host input unavailable") from None


def identifier(value):
    try:
        parsed = uuid.UUID(value)
        if parsed.version != 7 or str(parsed) != value:
            raise ValueError()
    except (ValueError, TypeError, AttributeError):
        raise GuidanceError("canonical UUIDv7 identifier required") from None
    return value


def timestamp(value):
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.utcoffset() != dt.timedelta(0):
            raise ValueError()
        return parsed.timestamp()
    except (ValueError, TypeError, AttributeError):
        raise GuidanceError("invalid guidance timestamp") from None


def validate_document(d, run_id, now):
    fields = {"contract_version", "revision", "scope", "issued_at", "expires_at", "governance", "execution", "operations", "markdown"}
    if not isinstance(d, dict) or set(d) != fields or d["contract_version"] != CONTRACT:
        raise GuidanceError("unsupported guidance contract")
    if not isinstance(d["revision"], str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", d["revision"]):
        raise GuidanceError("invalid guidance revision")
    scope = d["scope"]
    if not isinstance(scope, dict) or set(scope) != ({"tenant_id", "principal_id", "run_id"} if run_id else {"tenant_id", "principal_id"}):
        raise GuidanceError("invalid guidance scope")
    identifier(scope["tenant_id"]); identifier(scope["principal_id"])
    if run_id and scope.get("run_id") != run_id:
        raise GuidanceError("guidance Run scope mismatch")
    issued, expiry = timestamp(d["issued_at"]), timestamp(d["expires_at"])
    if not issued <= now + 2 or not now < expiry or not 0 < expiry - issued <= 30 or expiry > now + 32:
        raise GuidanceError("guidance expired or outside its lifetime")
    if d["governance"] != "ready" or d["execution"] != "unsupported":
        raise GuidanceError("unsupported capability state")
    operations = d["operations"]
    if not isinstance(operations, list) or not 1 <= len(operations) <= 8:
        raise GuidanceError("invalid capability catalog")
    seen = set()
    for op in operations:
        if not isinstance(op, dict) or set(op) != {"id", "method", "path", "prerequisite", "authorization"}:
            raise GuidanceError("invalid capability operation")
        name = op["id"]
        if not isinstance(name, str) or name in seen or ROUTES.get(name) != (op["method"], op["path"]) or op["authorization"] != "checked_per_request":
            raise GuidanceError("unsupported capability operation")
        if not isinstance(op["prerequisite"], str) or not re.fullmatch(r"[a-z_]{1,128}", op["prerequisite"]):
            raise GuidanceError("invalid capability prerequisite")
        seen.add(name)
    if not isinstance(d["markdown"], str) or len(d["markdown"].encode()) > 32768 or "\x00" in d["markdown"]:
        raise GuidanceError("invalid guidance instructions")
    return d


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Helper:
    def __init__(self, config_path):
        try:
            cfg = json.loads(private_read(config_path, 16384))
        except (ValueError, UnicodeError):
            raise GuidanceError("invalid host configuration") from None
        required = {"origin", "token_file", "state_dir"}
        if not isinstance(cfg, dict) or not required <= set(cfg) or set(cfg) - required - {"ca_file"}:
            raise GuidanceError("invalid host configuration")
        origin = cfg["origin"]
        if not isinstance(origin, str):
            raise GuidanceError("HTTPS AG origin required")
        try:
            u = urllib.parse.urlsplit(origin)
            if u.scheme != "https" or not u.hostname or u.username or u.password or u.path or u.query or u.fragment or any(c.isspace() for c in origin):
                raise ValueError()
            _ = u.port
        except ValueError:
            raise GuidanceError("exact HTTPS AG origin required") from None
        for name in ("token_file", "state_dir", "ca_file"):
            if name in cfg and (not isinstance(cfg[name], str) or not Path(cfg[name]).is_absolute()):
                raise GuidanceError("host file paths must be absolute")
        self.origin = origin
        try:
            self.token = private_read(cfg["token_file"], 65536).decode().strip()
        except UnicodeError:
            raise GuidanceError("invalid host token") from None
        if not self.token or any(c.isspace() for c in self.token):
            raise GuidanceError("invalid host token")
        self.state = Path(cfg["state_dir"])
        try:
            self.state.mkdir(mode=0o700, parents=True, exist_ok=True)
            info = self.state.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise GuidanceError("helper state directory must be owned and private")
            context = ssl.create_default_context(cafile=cfg.get("ca_file"))
        except (OSError, ssl.SSLError):
            raise GuidanceError("protected helper state or TLS trust unavailable") from None
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect(), urllib.request.HTTPSHandler(context=context))
        self.identity_key = hashlib.sha256((origin + "\0" + self.token).encode()).hexdigest()

    def request(self, path, method="GET", body=None, etag=None, key=None, limit=MAX_GUIDANCE):
        if not path.startswith("/v1/") or path.startswith("//"):
            raise GuidanceError("invalid AG route")
        headers = {"Authorization": "Bearer " + self.token, "Accept": "application/json"}
        if etag:
            headers["If-None-Match"] = etag
        if key:
            if not re.fullmatch(r"[A-Za-z0-9._:-]{16,128}", key):
                raise GuidanceError("Idempotency-Key must contain 16 to 128 safe characters")
            headers["Idempotency-Key"] = key
        data = None
        if body is not None:
            data = json.dumps(body, separators=(",", ":")).encode()
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(self.origin + path, data=data, headers=headers, method=method)
        try:
            response = self.opener.open(req, timeout=10)
        except urllib.error.HTTPError as e:
            if e.code == 304:
                e.close()
                return 304, e.headers, b""
            status = e.code
            e.close()
            raise GuidanceError("AG request rejected (HTTP %d); refresh guidance before continuing" % status, status=status) from None
        except (OSError, urllib.error.URLError, ValueError):
            raise GuidanceError("AG unavailable; stop dependent platform operations") from None
        with response:
            if response.geturl() != self.origin + path or response.status not in (200, 201):
                raise GuidanceError("unexpected AG response")
            raw = response.read(limit + 1)
            if len(raw) > limit or response.headers.get_content_type() != "application/json":
                raise GuidanceError("invalid or oversized AG response")
            return response.status, response.headers, raw

    def guidance(self, run_id=None):
        if run_id:
            identifier(run_id)
        cache = self.state / (hashlib.sha256((self.identity_key + (run_id or "")).encode()).hexdigest() + ".json")
        now = dt.datetime.now(dt.timezone.utc).timestamp()
        cached = None
        if cache.exists():
            try:
                cached = json.loads(private_read(cache, MAX_GUIDANCE + 1024))
                validate_document(cached["document"], run_id, now)
                if not re.fullmatch(r'"[0-9a-f]{64}"', cached["etag"]):
                    raise ValueError()
            except (GuidanceError, ValueError, TypeError, KeyError):
                cached = None
        path = "/v1/harness/capabilities?contract_version=" + urllib.parse.quote(CONTRACT, safe="")
        if run_id:
            path += "&run_id=" + run_id
        # Every invocation revalidates. No offline fallback, even during the TTL.
        try:
            try:
                status, headers, raw = self.request(path, etag=cached["etag"] if cached else None)
            except GuidanceError as error:
                if error.status != 409:
                    raise
                # Retry discovery once after a concurrent configuration change.
                # Never replay a mutation automatically.
                status, headers, raw = self.request(path)
            current_time = dt.datetime.now(dt.timezone.utc).timestamp()
            if status == 304:
                if not cached:
                    raise GuidanceError("unsolicited conditional response")
                doc = validate_document(cached["document"], run_id, current_time)
                if headers.get("X-AG-Capability-Revision") != doc["revision"] or timestamp(headers.get("X-AG-Guidance-Expires")) != timestamp(doc["expires_at"]):
                    raise GuidanceError("conditional guidance metadata mismatch")
                return doc
            doc = validate_document(json.loads(raw), run_id, current_time)
            etag = headers.get("ETag", "")
            if etag != '"' + hashlib.sha256(raw).hexdigest() + '"' or headers.get("X-AG-Capability-Revision") != doc["revision"] or timestamp(headers.get("X-AG-Guidance-Expires")) != timestamp(doc["expires_at"]):
                raise GuidanceError("guidance representation mismatch")
            fd, temp = tempfile.mkstemp(dir=self.state, prefix=".guidance-")
            try:
                with os.fdopen(fd, "w") as f:
                    json.dump({"etag": etag, "document": doc}, f)
                os.replace(temp, cache)
            finally:
                if os.path.exists(temp):
                    os.unlink(temp)
            return doc
        except (ValueError, TypeError, KeyError):
            raise GuidanceError("invalid guidance response; stop dependent platform operations") from None

    def operate(self, name, run_id=None, agent_id=None, objective=None, key=None):
        doc = self.guidance(run_id)
        if name not in {op["id"] for op in doc["operations"]}:
            raise GuidanceError("operation absent from current guidance")
        method, path = ROUTES[name]
        if run_id:
            path = path.replace("{run_id}", identifier(run_id))
        if agent_id:
            path = path.replace("{agent_id}", identifier(agent_id))
        body = {"objective": objective} if name == "runs.admit" else {"reason_code": "harness.cancel"} if name == "runs.cancel" else None
        try:
            _, _, raw = self.request(path, method=method, body=body, key=key, limit=1 << 20)
        except GuidanceError as error:
            if error.status == 409:
                try:
                    self.guidance(run_id)
                except GuidanceError:
                    pass
            raise
        try:
            response = json.loads(raw)
            if name == "agents.list":
                response = {"items": [{k: item[k] for k in ("id", "risk_class", "state") if k in item} for item in response["items"]], "next_cursor": response.get("next_cursor", "")}
            elif name in ("runs.admit", "runs.cancel"):
                # Refresh the actual new context before another platform action.
                try:
                    self.guidance(identifier(response["id"]))
                    response["guidance_refreshed"] = True
                except GuidanceError:
                    response["guidance_refreshed"] = False
            return response
        except (ValueError, KeyError, TypeError):
            raise GuidanceError("invalid AG operation response") from None


def main(argv=None):
    parser = argparse.ArgumentParser(description="Protected ThinkPixelAG guidance and governance helper")
    parser.add_argument("--config", default=str(Path.home() / ".config/thinkpixelag/harness.json"))
    commands = parser.add_subparsers(dest="command", required=True)
    guidance = commands.add_parser("guidance")
    guidance.add_argument("--run-id")
    guidance.add_argument("--json", action="store_true")
    commands.add_parser("agents")
    admit = commands.add_parser("admit")
    admit.add_argument("--agent-id", required=True)
    admit.add_argument("--objective-file", required=True)
    admit.add_argument("--idempotency-key", required=True)
    for name in ("run", "cancel"):
        command = commands.add_parser(name)
        command.add_argument("--run-id", required=True)
        if name == "cancel":
            command.add_argument("--idempotency-key", required=True)
    args = parser.parse_args(argv)
    try:
        helper = Helper(args.config)
        if args.command == "guidance":
            doc = helper.guidance(args.run_id)
            print(json.dumps(doc) if args.json else doc["markdown"], end="\n")
            return 0
        objective = None
        if args.command == "admit":
            with open(args.objective_file, "rb") as f:
                raw = f.read(16385)
            if not 0 < len(raw) <= 16384:
                raise GuidanceError("objective must contain 1 to 16384 UTF-8 bytes")
            objective = raw.decode()
        operation = {"agents": "agents.list", "admit": "runs.admit", "run": "runs.read", "cancel": "runs.cancel"}[args.command]
        result = helper.operate(operation, getattr(args, "run_id", None), getattr(args, "agent_id", None), objective, getattr(args, "idempotency_key", None))
        print(json.dumps(result, separators=(",", ":")))
        return 0
    except GuidanceError as e:
        print("thinkpixelag-harness: " + str(e), file=sys.stderr)
    except (OSError, ValueError, UnicodeError, TypeError):
        print("thinkpixelag-harness: invalid host input or transport response", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
