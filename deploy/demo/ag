#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
command_name=${1:-help}
state_dir=${AG_DEMO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/thinkpixelag-demo}
env_file=$state_dir/environment
if [[ $command_name == up || -f .env ]]; then
    umask 077
    mkdir -p -- "$state_dir"
    chmod 700 "$state_dir"
    # Reuse credentials from an earlier checkout-local setup, if present.
    if [[ ! -f $env_file && -f .env ]]; then
        mv -- .env "$env_file"
        chmod 600 "$env_file"
    fi
fi
if [[ $command_name == up && ! -f $env_file ]]; then
    command -v openssl >/dev/null
    umask 077
    # Noclobber prevents replacing another invocation's private configuration.
    (set -o noclobber; printf 'DATABASE_PASSWORD=%s\nCURSOR_KEY=%s\nEVIDENCE_TOKEN=%s\nAG_PORT=%s\n' \
        "$(openssl rand -hex 24)" "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" "${AG_PORT:-18080}" > "$env_file")
fi
if [[ -f $env_file ]]; then
    # The saved installation settings win over unrelated exported shell values.
    while IFS='=' read -r name value; do
        case "$name" in
            DATABASE_PASSWORD|CURSOR_KEY|EVIDENCE_TOKEN|AG_PORT) export "$name=$value" ;;
        esac
    done < "$env_file"
fi
compose=(docker compose --project-name thinkpixelag-demo --env-file "$env_file" -f compose.yaml)
case "$command_name" in
    up)
        "${compose[@]}" up --build --detach --wait --wait-timeout 180
        port=$(sed -n 's/^AG_PORT=//p' "$env_file")
        for ((attempt=0; attempt<60; attempt++)); do
            if curl --fail --silent "http://127.0.0.1:${port}/readyz" >/dev/null; then
                printf 'AG is ready at http://127.0.0.1:%s\nGet a caller token: ./deploy/demo/ag token\n' "$port"
                exit 0
            fi
            sleep 1
        done
        printf 'AG did not become ready. Inspect ./deploy/demo/ag logs\n' >&2
        exit 1
        ;;
    config-path) printf '%s\n' "$env_file" ;;
    token) "${compose[@]}" exec -T identity /bootstrap token /state ;;
    status) "${compose[@]}" ps ;;
    logs) "${compose[@]}" logs --tail 80 api provision identity opa ;;
    stop) "${compose[@]}" stop ;;
    *) printf 'Usage: ./deploy/demo/ag up|token|status|logs|stop|config-path\nState and credentials are retained across restarts.\n' ;;
esac
