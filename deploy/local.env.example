# Copy to the repository-root .env only when overriding safe local defaults.
# These values are deliberately non-production and bind only to loopback.
COMPOSE_PROJECT_NAME=thinkpixelag-dev
POSTGRES_DB=thinkpixelag_local
POSTGRES_USER=thinkpixelag_local
POSTGRES_PASSWORD=thinkpixelag_local_only_change_me
POSTGRES_PORT=5432
OPA_PORT=8181
VALKEY_PASSWORD=thinkpixelag_valkey_local_only_change_me
VALKEY_PORT=6379
